# Copy to .env and change these.
WEB_PORT=8484
# Password for the bundled MariaDB's "adastra" user
DB_PASSWORD=change-me
# Token for GET /api/messages (Authorization: Bearer <token>)
ADMIN_TOKEN=change-me-too

# Optional: use an existing database instead of the bundled "db" service.
# MariaDB / MySQL on the Docker host (e.g. aaPanel's MariaDB on server 1):
# DATABASE_URL=mysql://techadastra:password@host.docker.internal:3306/techadastra
# Any other MariaDB / MySQL:
# DATABASE_URL=mysql://user:password@host:3306/dbname
# PostgreSQL:
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Interface the site listens on (default 127.0.0.1 = this machine only).
# WEB_BIND=0.0.0.0
